# Copy to .env for local development: cp .env.example .env
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
POSTGRES_DB=chips
POSTGRES_USER=chips
POSTGRES_PASSWORD=chips
# Files are stored in backend/media/ by default. To test against a Cloudflare R2 bucket
# instead, fill these in:
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_PUBLIC=chips-dev-public
# S3_BUCKET_PRIVATE=chips-dev-private
