# Copy to /opt/django-academy/.env on the VM and fill in every value. Never commit the real file.
GHCR_OWNER=your-github-org-or-user
IMAGE_TAG=latest
SITE_ADDRESS=staging.hbcuchips.org:8080
ACME_EMAIL=admin@hbcuchips.org

ENVIRONMENT=staging
DJANGO_SECRET_KEY=generate-with-python-secrets-token-urlsafe-50
DJANGO_ALLOWED_HOSTS=staging.hbcuchips.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.hbcuchips.org:8080
PUBLIC_URL=https://staging.hbcuchips.org:8080

POSTGRES_DB=chips
POSTGRES_USER=chips
POSTGRES_PASSWORD=generate-a-long-random-password

# Files are stored on the VM's disk (Docker volume media_data) until M3.
# To move staging to Cloudflare R2, uncomment and fill in (see docs/staging.md):
# S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_PUBLIC=chips-staging-public
# S3_BUCKET_PRIVATE=chips-staging-private

SENTRY_DSN=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
