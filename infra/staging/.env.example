# Copy to /opt/django/.env on the VM and fill in every value. Never commit the real file.
GHCR_OWNER=your-github-org-or-user
IMAGE_TAG=latest
SITE_ADDRESS=staging.hbcuchip.org:8080
ACME_EMAIL=admin@hbcuchip.org

ENVIRONMENT=staging
DJANGO_SECRET_KEY=generate-with-python-secrets-token-urlsafe-50
DJANGO_ALLOWED_HOSTS=staging.hbcuchip.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.hbcuchip.org:8080
PUBLIC_URL=https://staging.hbcuchip.org:8080

POSTGRES_DB=chips
POSTGRES_USER=chips
POSTGRES_PASSWORD=generate-a-long-random-password

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=chips
S3_SECRET_KEY=generate-a-long-random-secret
S3_BUCKET_PUBLIC=chips-public
S3_BUCKET_PRIVATE=chips-private

SENTRY_DSN=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
